.tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:1px;background:var(--line-soft);border-top:1px solid var(--line-soft)}
.tiles div{background:var(--panel);padding:10px 16px}
.tiles .n{font:600 16px var(--mono)} .tiles .l{color:var(--ink-3);font-size:12px}

/* ---------- dialogs / toast ---------- */
dialog{background:var(--panel);color:var(--ink);border:1px solid var(--line);border-radius:12px;padding:0;width:min(540px,calc(100vw - 28px));max-height:calc(100vh - 40px)}
dialog::backdrop{background:rgba(5,10,16,.62)}
dialog .dh{padding:16px 20px 4px} dialog .dh h2{margin:0;font-size:17px;font-weight:600} dialog .dh p{margin:4px 0 0;color:var(--ink-3);font-size:13px}
dialog .db{padding:12px 20px 4px;overflow:auto;max-height:calc(100vh - 220px)}
