<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>ARCH Monitoring Station — network monitoring console</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;450;500;600&display=swap" rel="stylesheet">
<style>
:root{
  box-sizing:border-box;

  --bg:#0d1620; --panel:#16222e; --panel-2:#1c2b3a; --line:#26384c; --line-soft:#1f2f40;
  --ink:#e6eef6; --ink-2:#a9bccf; --ink-3:#8fa7bd;
  --up:#3fb98a; --warn:#e8a33d; --down:#ef5b5b; --idle:#33475d; --accent:#4fc3d9; --on-accent:#06222b;
  --sans:"IBM Plex Sans",system-ui,-apple-system,"Segoe UI",sans-serif;
  --mono:"IBM Plex Mono",ui-monospace,Menlo,Consolas,monospace;
  --rail:222px;
}
@media (prefers-color-scheme: light){
  :root:not([data-theme="dark"]){
    --bg:#eef1f5; --panel:#ffffff; --panel-2:#f5f7fa; --line:#d5dde6; --line-soft:#e3e9f0;
    --ink:#13202d; --ink-2:#4a5f75; --ink-3:#5c7084;
    --up:#1f9c6c; --warn:#b87611; --down:#cf3b3b; --idle:#c8d3de; --accent:#127f95; --on-accent:#ffffff;
  }
}
:root[data-theme="light"]{
  --bg:#eef1f5; --panel:#ffffff; --panel-2:#f5f7fa; --line:#d5dde6; --line-soft:#e3e9f0;
  --ink:#13202d; --ink-2:#4a5f75; --ink-3:#5c7084;
  --up:#1f9c6c; --warn:#b87611; --down:#cf3b3b; --idle:#c8d3de; --accent:#127f95; --on-accent:#ffffff;
}
*,*::before,*::after{box-sizing:inherit}
[hidden]{display:none!important}
html,body{height:100%;margin:0}
html{color-scheme:dark light}
body{
  background:var(--bg); color:var(--ink);
  font:15px/1.5 var(--sans); font-weight:400;
  display:grid; grid-template-columns:var(--rail) minmax(0,1fr); grid-template-rows:100%;
  -webkit-font-smoothing:antialiased;
}
button,input,select,textarea{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:3px}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
.mono{font-family:var(--mono);font-variant-numeric:tabular-nums}

/* ---------- rail ---------- */
.rail{background:var(--panel);border-right:1px solid var(--line);display:flex;flex-direction:column;min-height:0;overflow:auto;padding-top:env(safe-area-inset-top,0px)}
.brand{padding:18px 18px 12px}
.brand b{display:block;font-size:17px;font-weight:600;letter-spacing:-.01em}
.brand span{display:block;color:var(--ink-3);font-size:12.5px;margin-top:2px}
.nav{padding:0 10px 10px;display:flex;flex-direction:column;gap:1px}
.nav .grp{color:var(--ink-3);font-size:12px;font-weight:500;padding:14px 10px 5px}
.nav button{display:flex;align-items:center;gap:10px;width:100%;text-align:left;background:none;border:0;border-radius:6px;padding:7px 10px;cursor:pointer;color:var(--ink-2);font-size:14px}
.nav button:hover{background:var(--panel-2);color:var(--ink)}
.nav button[aria-current="page"]{background:var(--panel-2);color:var(--ink);font-weight:500;box-shadow:inset 2px 0 0 var(--accent)}
.nav .count{margin-left:auto;font:500 11.5px/1 var(--mono);padding:3px 6px;border-radius:4px;background:var(--line);color:var(--ink-2)}
.nav .count.hot{background:color-mix(in srgb,var(--down) 22%,transparent);color:var(--down)}
.nav .count.amber{background:color-mix(in srgb,var(--warn) 22%,transparent);color:var(--warn)}
.nav .count:empty{display:none}
.nav svg{flex:none;width:17px;height:17px;stroke:currentColor;fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.poller{margin-top:auto;border-top:1px solid var(--line-soft);padding:14px 18px 18px;font-size:12.5px;color:var(--ink-3)}
.poller .row{display:flex;justify-content:space-between;gap:10px;padding:2px 0}
.poller .row b{font:500 12.5px var(--mono);color:var(--ink-2)}
.beat{display:flex;gap:2px;height:22px;align-items:flex-end;margin:0 0 10px}
.beat i{flex:1;background:var(--accent);opacity:.5;border-radius:1px}
.beat i:last-child{opacity:1}

/* ---------- shell ---------- */
.main{display:flex;flex-direction:column;min-width:0;min-height:0}
.topbar{display:flex;align-items:center;gap:14px;padding:12px 22px;border-bottom:1px solid var(--line);background:var(--panel);padding-top:calc(12px + env(safe-area-inset-top,0px))}
.topbar h1{margin:0;font-size:18px;font-weight:600;letter-spacing:-.01em}
.topbar .sub{color:var(--ink-3);font-size:13px}
.search{margin-left:auto;display:flex;align-items:center;gap:8px;background:var(--panel-2);border:1px solid var(--line);border-radius:7px;padding:6px 10px;min-width:210px}
.search input{background:none;border:0;outline:none;width:100%;font-size:13.5px}
.search svg{width:15px;height:15px;stroke:var(--ink-3);fill:none;stroke-width:1.8}
.ghost{background:var(--panel-2);border:1px solid var(--line);border-radius:7px;padding:6px 11px;cursor:pointer;font-size:13.5px}
.ghost:hover{border-color:var(--ink-3)}
.ghost.sm{padding:3px 9px;font-size:12.5px}
.ghost.danger{color:var(--down)} .ghost.danger:hover{border-color:var(--down)}
.primary{background:var(--accent);color:var(--on-accent);border:0;border-radius:7px;padding:7px 14px;font-weight:600;cursor:pointer;font-size:13.5px}
.primary:hover{filter:brightness(1.08)}
.primary[disabled],.ghost[disabled]{opacity:.5;cursor:not-allowed}
.ctl{background:var(--panel-2);border:1px solid var(--line);border-radius:7px;padding:6px 10px;min-width:0;font-size:13.5px}
.ctl:hover{border-color:var(--ink-3)}
.seg{display:inline-flex;border:1px solid var(--line);border-radius:7px;overflow:hidden;background:var(--panel-2)}
.seg button{background:none;border:0;padding:5px 11px;cursor:pointer;color:var(--ink-2);font-size:13px}
.seg button[aria-pressed="true"]{background:var(--line);color:var(--ink)}
.view{flex:1;overflow:auto;padding:22px;min-height:0}
.view[hidden]{display:none}
.toolbar{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-bottom:14px}
.toolbar .grow{margin-left:auto}
.toolbar .note{color:var(--ink-3);font-size:13px}

/* ---------- stats ---------- */
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1px;background:var(--line);border:1px solid var(--line);border-radius:9px;overflow:hidden;margin-bottom:22px}
.stat{background:var(--panel);padding:13px 16px;border:0;text-align:left;font:inherit;color:inherit}
button.stat{cursor:pointer} button.stat:hover{background:var(--panel-2)}
.stat .n{font:600 25px/1.15 var(--mono);letter-spacing:-.02em}
.stat .l{color:var(--ink-3);font-size:12.5px;margin-top:3px}
.stat.bad .n{color:var(--down)} .stat.warn .n{color:var(--warn)} .stat.ok .n{color:var(--up)}

/* ---------- fleet panel ---------- */
.sitehead{display:flex;align-items:baseline;gap:10px;margin:18px 0 8px}.sitehead h3{margin:0;font-size:13px;font-weight:600}.sitehead .note{color:var(--ink-3);font-size:12px}
.sectionhead{display:flex;align-items:baseline;gap:12px;margin:0 0 12px;flex-wrap:wrap}
.sectionhead h2{margin:0;font-size:15px;font-weight:600}
.sectionhead p{margin:0;color:var(--ink-3);font-size:13px}
.sectionhead .right{margin-left:auto;display:flex;gap:14px;align-items:center;color:var(--ink-3);font-size:12.5px}
.sw{display:inline-block;width:9px;height:7px;border-radius:2px;margin-right:6px}
.wall{display:grid;grid-template-columns:repeat(auto-fill,minmax(325px,1fr));gap:14px}
.dev{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:13px 15px 15px;cursor:pointer;text-align:left;width:100%;display:block}.dev:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.dev:hover{border-color:var(--ink-3)}
.dev.is-down{border-color:color-mix(in srgb,var(--down) 55%,var(--line))}
.dev header{display:flex;align-items:center;gap:9px;margin-bottom:3px}
.dev .dot{width:8px;height:8px;border-radius:50%;background:var(--up);flex:none}
.dev.is-down .dot{background:var(--down)} .dev.is-warn .dot{background:var(--warn)} .dev.is-pending .dot{background:var(--idle)}
.dev h3{margin:0;font:600 14px var(--mono);letter-spacing:-.01em}
.dev .model{margin-left:auto;color:var(--ink-3);font-size:11.5px}
.dev .meta{color:var(--ink-3);font-size:12px;margin-bottom:11px}
.panelports{display:flex;gap:9px;align-items:flex-end;background:var(--panel-2);border:1px solid var(--line-soft);border-radius:6px;padding:8px 9px}
.bank{display:grid;grid-auto-flow:column;grid-template-rows:repeat(2,1fr);gap:3px}
.bank i{width:11px;height:8px;border-radius:1.5px;background:var(--idle);display:block;position:relative}.bank i::after{content:'';position:absolute;inset:-2px;border:1px solid transparent;border-radius:2px}.bank i.down::after{border-color:var(--down)}.bank i.warn::after{border-color:var(--warn)}
.bank i.up{background:var(--up)} .bank i.warn{background:var(--warn)} .bank i.down{background:var(--down)}
.bank i.busy{background:var(--up);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--accent) 80%,transparent)}
.bank.sfp i{width:15px;height:10px}
.bankwrap{display:flex;flex-direction:column;gap:4px}
.bankwrap span{font:500 9.5px var(--mono);color:var(--ink-3)}
.dev footer{display:flex;gap:16px;margin-top:10px;color:var(--ink-3);font-size:12px}
.dev footer b{font:500 12px var(--mono);color:var(--ink-2)}

/* ---------- cards / tables ---------- */
.split{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:22px;align-items:start}
.cols{display:grid;grid-template-columns:290px minmax(0,1fr);gap:18px;align-items:start}
.cols.lat{grid-template-columns:minmax(0,490px) minmax(0,1fr)}
.card{background:var(--panel);border:1px solid var(--line);border-radius:10px;min-width:0}
.card > h2{margin:0;padding:13px 16px;border-bottom:1px solid var(--line-soft);font-size:14px;font-weight:600;display:flex;align-items:center;gap:9px;flex-wrap:wrap}
.card > h2 .count{margin-left:auto;font:500 11.5px var(--mono);color:var(--ink-3)}
.card > h2 .acts{margin-left:auto;display:flex;gap:8px;align-items:center}
.scroll{overflow:auto}
table{width:100%;border-collapse:collapse;font-size:13.5px}
th{text-align:left;font-weight:500;color:var(--ink-3);font-size:12.5px;padding:9px 16px;border-bottom:1px solid var(--line);white-space:nowrap}
td{padding:9px 16px;border-bottom:1px solid var(--line-soft);vertical-align:middle}
tbody tr:last-child td{border-bottom:0}
tbody tr.clickable{cursor:pointer}
tbody tr.clickable:hover{background:var(--panel-2)}
tbody tr.sel{background:var(--panel-2);box-shadow:inset 2px 0 0 var(--accent)}
th.num,td.num{font-family:var(--mono);font-variant-numeric:tabular-nums;text-align:right;white-space:nowrap}
th.num{font-family:var(--sans)}
td .name{font-family:var(--mono);font-weight:500;white-space:nowrap}
td.mono,td .mono{font-family:var(--mono);font-size:12.5px}
td.wrap{white-space:normal;overflow-wrap:anywhere}
.pill{display:inline-flex;align-items:center;gap:6px;font-size:12px;color:var(--ink-2);white-space:nowrap}
.pill::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--idle)}
.pill.up::before,.pill.ok::before{background:var(--up)} .pill.down::before,.pill.crit::before{background:var(--down)} .pill.warn::before{background:var(--warn)}
.bar{height:5px;border-radius:3px;background:var(--line);overflow:hidden;min-width:56px}
.bar i{display:block;height:100%;background:var(--accent);border-radius:3px}
.bar i.hot{background:var(--warn)} .bar i.crit{background:var(--down)}
.empty{padding:34px 16px;text-align:center;color:var(--ink-3);font-size:13.5px}
.tag{display:inline-block;font:500 11.5px var(--mono);padding:2px 6px;border-radius:4px;background:var(--line);color:var(--ink-2)}
.tag.add{background:color-mix(in srgb,var(--up) 20%,transparent);color:var(--up)}
.tag.del{background:color-mix(in srgb,var(--down) 20%,transparent);color:var(--down)}
.tag.warn{background:color-mix(in srgb,var(--warn) 20%,transparent);color:var(--warn)}

/* ---------- device detail ---------- */
.back{background:none;border:0;color:var(--ink-3);cursor:pointer;font-size:13px;padding:0;margin-bottom:12px}
.back:hover{color:var(--ink)}
.devhead{display:flex;align-items:flex-start;gap:18px;flex-wrap:wrap;margin-bottom:18px}
.devhead h2{margin:0;font:600 22px var(--mono);letter-spacing:-.02em}
.devhead .sub{color:var(--ink-3);font-size:13px;margin-top:4px}
.devhead .kpis{margin-left:auto;display:flex;gap:26px}
.kpi .n{font:600 19px var(--mono)} .kpi .l{color:var(--ink-3);font-size:12px}
.spark{width:100%;height:96px;display:block}
.spark .fill{fill:color-mix(in srgb,var(--accent) 16%,transparent)}
.spark .stroke{fill:none;stroke:var(--accent);stroke-width:1.8;stroke-linejoin:round}
.spark .grid{stroke:var(--line-soft);stroke-width:1}
.legend{display:flex;gap:16px;color:var(--ink-3);font-size:12px;padding:0 16px 13px;flex-wrap:wrap}
.legend i{display:inline-block;width:11px;height:3px;border-radius:2px;background:var(--accent);margin-right:6px;vertical-align:middle}

/* ---------- topology ---------- */
.map{width:100%;height:min(600px,72vh);min-height:420px;display:block;background:radial-gradient(circle at 1px 1px,var(--line-soft) 1px,transparent 0) 0 0/22px 22px;border-radius:0 0 10px 10px}
.map .link{stroke:var(--up);stroke-width:2.2;stroke-linecap:round}
.map .link.lag{stroke-width:5} .map .link.dn{stroke:var(--down);stroke-dasharray:7 6} .map .link.rt{stroke:var(--warn)}
.map .box{fill:var(--panel);stroke:var(--line);stroke-width:1.4} .map .box.bad{stroke:var(--down);stroke-width:2} .map .box.free{stroke-dasharray:5 4}
.map .nm{font:600 12.5px var(--mono);fill:var(--ink)} .map .rl{font:11px var(--sans);fill:var(--ink-3)}
.map .pl{font:10px var(--mono);fill:var(--ink-3);paint-order:stroke;stroke:var(--panel);stroke-width:5px;stroke-linejoin:round}
.maplegend{display:flex;gap:18px;flex-wrap:wrap;padding:12px 16px;color:var(--ink-3);font-size:12.5px;border-top:1px solid var(--line-soft)}
.maplegend b{display:inline-block;width:16px;height:3px;border-radius:2px;background:var(--up);margin-right:7px;vertical-align:middle}

/* ---------- topology site selector ---------- */
.topo-sites{display:grid;grid-template-columns:repeat(auto-fit,minmax(155px,1fr));gap:8px;margin-bottom:12px}
.topo-site{background:var(--panel-2);border:1px solid var(--line);border-radius:8px;padding:9px 11px;text-align:left;cursor:pointer;min-width:0}
.topo-site:hover{border-color:var(--ink-3)}
.topo-site[aria-pressed="true"]{border-color:var(--accent);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--accent) 45%,transparent);background:color-mix(in srgb,var(--accent) 8%,var(--panel-2))}
.topo-site .site-name{font:600 12.5px var(--mono);display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.topo-site .site-type{display:block;color:var(--ink-3);font-size:11.5px;margin-top:2px}
.topo-site .site-live{display:inline-flex;align-items:center;gap:5px;color:var(--ink-3);font-size:11px;margin-top:6px}
.topo-site .site-live i{width:7px;height:7px;border-radius:50%;background:var(--up);display:inline-block}
.topo-site .site-live.warn i{background:var(--warn)}
.topo-site .site-live.down i{background:var(--down)}
.topo-head{display:flex;align-items:flex-start;gap:16px;padding:14px 16px;border-bottom:1px solid var(--line-soft);flex-wrap:wrap}
.topo-head h3{margin:0;font-size:15px}.topo-head .sub{color:var(--ink-3);font-size:12px;margin-top:2px}
.topo-kpis{margin-left:auto;display:flex;gap:20px;flex-wrap:wrap}.topo-kpi b{display:block;font:600 15px var(--mono)}.topo-kpi span{display:block;color:var(--ink-3);font-size:11px}
.topo-layout{display:grid;grid-template-columns:minmax(0,1fr) 250px;min-width:0}.topo-side{border-left:1px solid var(--line-soft);padding:15px;min-width:0}.topo-side h4{margin:0 0 9px;font-size:12px}.topo-side .detail-row{display:flex;justify-content:space-between;gap:10px;padding:5px 0;border-bottom:1px solid var(--line-soft);font-size:12px}.topo-side .detail-row span{color:var(--ink-3)}.topo-side .detail-row b{font-family:var(--mono);font-weight:500;text-align:right}.topo-device-list{margin-top:14px}.topo-device{display:flex;align-items:center;gap:7px;padding:5px 0;font:11.5px var(--mono)}.topo-device i{width:7px;height:7px;border-radius:50%;background:var(--up);flex:none}.topo-device.warn i{background:var(--warn)}.topo-device.down i{background:var(--down)}
.map{height:min(650px,70vh);min-height:480px}
.map .node{cursor:pointer}.map .node:focus{outline:none}.map .node:focus .box{stroke:var(--accent);stroke-width:2.5}
.map .box.dc{stroke:color-mix(in srgb,var(--accent) 60%,var(--line))}.map .server-box{fill:var(--panel-2)}
.map .node-label{font:600 12px var(--mono);fill:var(--ink)}.map .node-role{font:10.5px var(--sans);fill:var(--ink-3)}
.map .state-dot{stroke:var(--panel);stroke-width:2}.map .state-dot.up{fill:var(--up)}.map .state-dot.warn{fill:var(--warn)}.map .state-dot.down{fill:var(--down)}
@media(max-width:900px){.topo-layout{grid-template-columns:1fr}.topo-side{border-left:0;border-top:1px solid var(--line-soft)}.topo-kpis{margin-left:0}.topo-sites{grid-template-columns:repeat(2,minmax(0,1fr))}}

/* ---------- alerts ---------- */
.alert{display:flex;gap:11px;padding:12px 16px;border-bottom:1px solid var(--line-soft)}
.alert:last-child{border-bottom:0}
.alert .sev{width:3px;border-radius:2px;flex:none;background:var(--warn)}
.alert.crit .sev{background:var(--down)} .alert.info .sev{background:var(--accent)}
.alert .body{min-width:0;flex:1}
.alert .t{font-size:13.5px;line-height:1.4}
.alert .m{color:var(--ink-3);font-size:12px;margin-top:3px;display:flex;gap:9px;flex-wrap:wrap}
.alert .ack{background:none;border:1px solid var(--line);border-radius:5px;color:var(--ink-3);font-size:11.5px;padding:3px 8px;cursor:pointer;height:fit-content}
.alert .ack:hover{color:var(--ink);border-color:var(--ink-3)}
.alert.acked{opacity:.5} .alert.acked .ack{border-style:dashed;cursor:default}

/* ---------- code viewer / diff ---------- */
.code{font:12.5px/1.6 var(--mono);background:var(--panel-2);overflow:auto;max-height:calc(100vh - 300px);min-height:200px;border-radius:0 0 10px 10px;padding:6px 0}
.code .ln{display:grid;grid-template-columns:52px 18px minmax(max-content,1fr);white-space:pre;padding-right:16px}
.code .ln .no{color:var(--ink-3);text-align:right;padding-right:12px;user-select:none;opacity:.8}
.code .ln .sg{color:var(--ink-3);user-select:none}
.code .ln.cm .tx{color:var(--ink-3)}
.code .ln.hd .tx{color:var(--ink);font-weight:600}
.code .ln.sc .tx{color:var(--warn)}
.code .ln.add{background:color-mix(in srgb,var(--up) 15%,transparent)} .code .ln.add .sg{color:var(--up)}
.code .ln.del{background:color-mix(in srgb,var(--down) 15%,transparent)} .code .ln.del .sg{color:var(--down)}
.code .ln.hit{background:color-mix(in srgb,var(--accent) 12%,transparent)}
.code mark{background:color-mix(in srgb,var(--accent) 45%,transparent);color:inherit;border-radius:2px}
.code .fold{display:block;width:100%;text-align:left;background:color-mix(in srgb,var(--accent) 8%,transparent);border:0;border-top:1px solid var(--line-soft);border-bottom:1px solid var(--line-soft);color:var(--ink-3);font:12px var(--sans);padding:3px 16px 3px 70px;cursor:pointer}
.code .fold:hover{color:var(--ink)}
.list .item{display:block;width:100%;text-align:left;background:none;border:0;border-bottom:1px solid var(--line-soft);padding:10px 16px;cursor:pointer}
.list .item:last-child{border-bottom:0}
.list .item:hover{background:var(--panel-2)}
.list .item[aria-current="true"]{background:var(--panel-2);box-shadow:inset 2px 0 0 var(--accent)}
.list .item .a{display:flex;align-items:center;gap:8px}
.list .item .a b{font:500 13px var(--mono)}
.list .item .b{color:var(--ink-3);font-size:12px;margin-top:2px}
.cfg-device-row{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%}
.cfg-device-main{min-width:0;flex:1}
.cfg-backup-state{display:inline-flex;align-items:center;gap:7px;font-size:12px;white-space:nowrap}
