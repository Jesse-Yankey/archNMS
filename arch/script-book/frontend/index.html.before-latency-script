  const top = Math.max(...sl.map(s => s.max || 0), 0.5), nice = [1, 2, 5, 10, 20, 50, 100, 200].find(x => x >= top * 1.08) || Math.ceil(top);
  const x = i => m.l + i / (sl.length - 1) * iw, y = v => m.t + ih - (v / nice) * ih;
  const s = svg('svg', { class: 'smoke', viewBox: `0 0 ${W} ${H}`, role: 'img' });
  if (big) for (let g = 0; g <= 4; g++) {
    const yy = m.t + ih * g / 4; s.append(svg('line', { class: 'grid', x1: m.l, x2: W - m.r, y1: yy, y2: yy }));
    const tx = svg('text', { class: 'ax', x: m.l - 6, y: yy + 3.5, 'text-anchor': 'end' }); tx.textContent = `${+(nice * (1 - g / 4)).toFixed(1)} ms`; s.append(tx);
  }
  const band = (lo, hi, cls) => {
    let up = '', dn = []; sl.forEach((q, i) => { if (q.med == null) return; up += `${up ? 'L' : 'M'}${x(i).toFixed(1)} ${y(q[hi]).toFixed(1)} `; dn.push(`L${x(i).toFixed(1)} ${y(q[lo]).toFixed(1)}`); });
