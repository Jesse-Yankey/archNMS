  band('min', 'max', 'band1'); band('p25', 'p75', 'band2');
  for (let i = 1; i < sl.length; i++) if (sl[i].med != null && sl[i - 1].med != null)
    s.append(svg('line', { x1: x(i - 1), y1: y(sl[i - 1].med), x2: x(i), y2: y(sl[i].med), stroke: lossColor(sl[i].lost), 'stroke-width': big ? 2 : 1.4, 'stroke-linecap': 'round' }));
  if (big) { const R = RANGES[range]; for (let i = 0; i < sl.length; i += R.tick) { const tx = svg('text', { class: 'ax', x: x(i), y: H - 6, 'text-anchor': i === 0 ? 'start' : 'middle' }); tx.textContent = R.fmt(i); s.append(tx); } }
