.field{display:grid;gap:5px;margin-bottom:13px} .field label{font-size:13px;color:var(--ink-2)}
.field .ctl{width:100%}
.frow{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.result{border:1px solid var(--line);border-radius:8px;padding:10px 12px;font-size:13px;margin-bottom:12px;background:var(--panel-2)}
.result.ok{border-color:color-mix(in srgb,var(--up) 50%,var(--line))} .result.bad{border-color:color-mix(in srgb,var(--down) 50%,var(--line))}
.result div{margin:1px 0}
.result .mono{font-size:12.5px}
.check{display:flex;gap:9px;align-items:flex-start;font-size:13.5px;margin:10px 0}
.toast{position:fixed;right:20px;bottom:calc(20px + env(safe-area-inset-bottom,0px));background:var(--panel);border:1px solid var(--line);border-left:3px solid var(--accent);border-radius:8px;padding:10px 14px;font-size:13.5px;box-shadow:0 8px 28px rgba(0,0,0,.35);z-index:50;max-width:min(380px,calc(100vw - 40px))}

@media (max-width:1180px){ .split,.cols,.cols.lat{grid-template-columns:1fr} }
