.banner{display:flex;gap:12px;align-items:flex-start;padding:11px 14px;border:1px solid color-mix(in srgb,var(--warn) 45%,var(--line));background:color-mix(in srgb,var(--warn) 9%,transparent);border-radius:9px;margin-bottom:16px;font-size:13.5px}
