.st{display:inline-block;min-width:74px;text-align:center;font:600 11.5px var(--mono);padding:2px 7px;border-radius:4px}
.st.OK{background:color-mix(in srgb,var(--up) 20%,transparent);color:var(--up)}
.st.WARNING{background:color-mix(in srgb,var(--warn) 22%,transparent);color:var(--warn)}
.st.CRITICAL{background:color-mix(in srgb,var(--down) 22%,transparent);color:var(--down)}
.st.UNKNOWN,.st.PENDING{background:var(--line);color:var(--ink-2)}
td.host{font:600 13px var(--mono);vertical-align:top;padding-top:11px}
tr.first td{border-top:1px solid var(--line)}

/* ---------- latency ---------- */
.smoke{width:100%;height:auto;display:block}
.smoke .grid{stroke:var(--line-soft);stroke-width:1}
